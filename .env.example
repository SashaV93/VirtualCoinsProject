# Copy this file to `.env` and fill in your keys, then restart `npm run dev`.
# Both keys are OPTIONAL — the app runs without them (see README).
# Anything you type into the app's own settings panels overrides these values.
#
# WARNING: Vite inlines VITE_* variables into the JavaScript bundle, so a key
# put here is visible to anyone who opens the deployed site. For a public
# deployment, prefer typing the key into the app's settings panel instead —
# it is then kept in your own browser's localStorage only.

# https://platform.openai.com/api-keys  — used by the AI Insight page
VITE_OPENAI_API_KEY=

# https://developers.coindesk.com/  — used by the Live Reports page
VITE_CRYPTOCOMPARE_API_KEY=
